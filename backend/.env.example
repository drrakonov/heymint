# Server
PORT=5000
CORS_ORIGIN=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database
DATABASE_URL=

# Authentication
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_NAME=refreshToken
COOKIE_SECURE=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=HeyMint <onboarding@your-domain.com>
# Used in email copy; OTP expiration is currently hard-coded to 3 minutes.
OTP_EXPIRY_MINUTES=3

# AI providers
GEMINI_API_KEY=
GROQ_API_KEY=

# Stream transcription worker
TRANSCRIPTION_WORKER_POLL_MS=5000
TRANSCRIPTION_WORKER_MAX_ATTEMPTS=5
TRANSCRIPTION_WORKER_LEASE_MS=300000
TRANSCRIPTION_DOWNLOAD_TIMEOUT_MS=60000

# GetStream
STREAM_API_KEY=
STREAM_SECRET_KEY=
