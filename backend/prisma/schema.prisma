generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                    String               @id @default(uuid())
  name                  String
  email                 String               @unique
  password              String?
  googleId              String?              @unique
  provider              Provider             @default(local)
  meetings              Meeting[]            @relation("createdMeetings")
  meetingParticipations MeetingParticipant[]
  refreshTokens         RefreshToken[]
}

model Meeting {
  id                 String               @id @default(uuid())
  title              String
  desc               String
  createdById        String
  createdAt          DateTime             @default(now())
  isDeleted          Boolean              @default(false)
  isComplete         Boolean              @default(false)
  startedAt          DateTime?
  startingTime       DateTime
  isProtected        Boolean
  password           String?
  meetingCode        String               @unique
  isScheduled        Boolean              @default(false)
  createdBy          User                 @relation("createdMeetings", fields: [createdById], references: [id])
  participants       MeetingParticipant[]
  summary            Summary?
  transcriptChunks   TranscriptChunk[]
  transcriptSegments TranscriptSegment[]
  transcriptionJobs  TranscriptionJob[]
}

model MeetingParticipant {
  id            String   @id @default(uuid())
  meetingId     String
  userId        String
  firstJoinedAt DateTime @default(now())
  lastJoinedAt  DateTime @default(now())
  joinCount     Int      @default(1)
  meeting       Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId, firstJoinedAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum Provider {
  local
  google
}

model Summary {
  id            Int     @id @default(autoincrement())
  content       String
  transcription String?
  meetingId     String  @unique
  meeting       Meeting @relation(fields: [meetingId], references: [id])
}

model TranscriptChunk {
  id        String                     @id @default(uuid())
  content   String
  meetingId String
  meeting   Meeting                    @relation(fields: [meetingId], references: [id])
  embedding Unsupported("vector(768)")
}

enum TranscriptionJobStatus {
  WAITING
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model TranscriptionJob {
  id               String                 @id @default(uuid())
  sourceId         String
  meetingId        String
  sessionId        String?
  transcriptionUrl String?
  filename         String?
  status           TranscriptionJobStatus @default(WAITING)
  attempts         Int                    @default(0)
  availableAt      DateTime               @default(now())
  leaseToken       String?
  leaseExpiresAt   DateTime?
  lastError        String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  meeting          Meeting                @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  segments         TranscriptSegment[]

  @@unique([meetingId, sourceId])
  @@index([status, availableAt])
  @@index([meetingId])
}

model TranscriptSegment {
  id                 String           @id @default(uuid())
  meetingId          String
  transcriptionJobId String
  sequence           Int
  sessionId          String
  speakerId          String
  speakerName        String?
  startedAt          DateTime
  endedAt            DateTime
  startMs            Int
  endMs              Int
  text               String
  createdAt          DateTime         @default(now())
  meeting            Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  transcriptionJob   TranscriptionJob @relation(fields: [transcriptionJobId], references: [id], onDelete: Cascade)

  @@unique([transcriptionJobId, sequence])
  @@index([meetingId, startMs])
  @@index([meetingId, sessionId])
}
